# 服务器配置
PORT=3000
NODE_ENV=development

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS 配置
# 允许访问的前端来源，**必须与浏览器地址栏的协议 + 域名 + 端口完全一致**，否则接口会被拒。
# 多个来源用英文逗号分隔，例如同时用域名和 IP 访问：
#   FRONTEND_URL=https://pet.uwper.cn,http://192.168.1.10
# 本地开发（NODE_ENV=development）时，localhost / 127.0.0.1 的任意端口会自动放行，
# 所以本地用 localhost:5173 调试时，这里保持生产域名也没关系，不用改。
FRONTEND_URL=http://localhost:5173
# 临时排障可用 CORS_ALLOW_ALL=true 放行任意来源（生产环境别用，启动时会有警告）
# CORS_ALLOW_ALL=false
# AI 配置（火山引擎 doubao / OpenAI 兼容网关）
# 优先读取数据库 settings.ai_* 项；未配置时 fallback 到下列环境变量
# 数据库优先，环境变量 fallback
AI_API_KEY="你的AI API Key"
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-2-0-pro-260215